# ==========================================
# Clash Royale Discord Bot - Umgebungsvariablen
# ==========================================

# Discord Bot Konfiguration
# Hol dir deinen Token und Client-ID aus dem Discord Developer Portal:
# https://discord.com/developers/applications
DISCORD_TOKEN=dein_discord_bot_token_hier
DISCORD_CLIENT_ID=deine_discord_client_id_hier

# Clash Royale API Konfiguration
# Erstelle einen API-Schlüssel auf: https://developer.clashroyale.com/
# ACHTUNG: Der API-Key ist an die externe IP-Adresse deines Servers gebunden!
CLASH_ROYALE_API_KEY=dein_clash_royale_api_token_hier

# Optionaler Standard-Clan-Tag (kann auch im Discord via /setclan geändert werden)
# z.B. #2PP oder 2PP
DEFAULT_CLAN_TAG=#2PP

# Zeitzone für die Ausführung von Reports (Standard: Europe/Berlin)
TZ=Europe/Berlin

# Pfad zur SQLite-Datenbank (Standard: data/clashbot.db)
DATABASE_PATH=data/clashbot.db
